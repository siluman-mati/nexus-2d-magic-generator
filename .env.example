# NEXUS Brain - Environment Variables
# =====================================
# Copy this file to .env.local for local development
# For Vercel production, set these in Vercel Dashboard -> Settings -> Environment Variables

# --- PRIMARY PROVIDER - GROQ (Wajib untuk production) ---
# Dapatkan API key di: https://console.groq.com/keys
# Groq adalah provider utama - cepat, gratis tier tersedia, 1000+ T/s
# Model aktif: openai/gpt-oss-20b (1000 T/s), openai/gpt-oss-120b (500 T/s)
# Deprecated: llama-3.3-70b-versatile -> Enterprise only Aug 2026
GROQ_API_KEY=
# Model dapat dikonfigurasi via env - ganti tanpa ubah source code
# Default: openai/gpt-oss-20b (production-ready, 1000 T/s)
GROQ_MODEL=openai/gpt-oss-20b
# Optional: enable/disable Groq - default true jika key ada
GROQ_ENABLED=true

# --- FALLBACK PROVIDER - OPENROUTER (Recommended untuk fallback) ---
# Dapatkan API key di: https://openrouter.ai/keys
# OpenRouter adalah fallback cloud - otomatis dipakai jika Groq gagal/timeout
# Support both naming: OPENROUTER_API_KEY and OPEN_ROUTER_API_KEY (alias)
OPENROUTER_API_KEY=
# Alias support - jika sudah ada OPEN_ROUTER_API_KEY, tetap work
OPEN_ROUTER_API_KEY=
# Model OpenRouter - default free tier
# Contoh: meta-llama/llama-3.3-70b-instruct:free, meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPEN_ROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_ENABLED=true

# --- LOCAL AI - DEV ONLY (Jangan pakai di Vercel production) ---
# Local AI hanya untuk development lokal - localhost tidak tersedia di Vercel serverless
# Untuk production Vercel, gunakan GROQ_API_KEY atau OPENROUTER_API_KEY
# Jika LOCAL_AI_ENABLED=true dan URL adalah localhost, akan otomatis DISABLED di Vercel production
LOCAL_AI_ENABLED=false
LOCAL_AI_URL=http://localhost:11434
LOCAL_AI_MODEL=llama3.1
# Alias support
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_ENABLED=false

# --- NEXUS BRAIN CONFIG ---
# Timeout untuk request AI - default 30s
NEXUS_TIMEOUT_MS=30000
AI_TIMEOUT_MS=30000
# Retry attempts - 0-2, default 1 (total 2 attempts: 1 initial + 1 retry)
NEXUS_RETRY_ATTEMPTS=1
# Failover enabled - jika false, tidak akan fallback ke provider lain
NEXUS_FAILOVER_ENABLED=true

# --- GEMINI LEGACY (Jangan pakai untuk NEXUS Brain) ---
# Gemini adalah legacy only, TIDAK digunakan di jalur NEXUS Brain
# Kept for backward compatibility only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_ENABLED=false

# --- IMAGE ENGINE - Provider Abstraction: huggingface (default free ZeroGPU) | pollinations (free fallback) | remote_comfyui (RunPod paid) ---
# Default IMAGE_ENGINE_PROVIDER=huggingface per spec - Free testing dari HP tanpa RunPod/PC/localhost
# Priority: 1 HF ZeroGPU, 2 Pollinations free fallback (zero budget, no API key), 3 remote_comfyui only if configured
IMAGE_ENGINE_PROVIDER=huggingface

# --- FINAL ARENA - IMAGEFX via @rohitaryal/imagefx-api (Primary 2D PNG Real) ---
# Package: @rohitaryal/imagefx-api — https://github.com/rohitaryal/imageFX-api
# Docs: https://labs.google/fx/tools/image-fx -> ImageFX via Cookie Editor
# REQUIRED ENV: GOOGLE_COOKIE — server-only, never NEXT_PUBLIC, never browser
# How to get cookie: Login https://labs.google/fx/tools/image-fx -> Install Cookie Editor extension -> Export -> Header String -> Paste as GOOGLE_COOKIE
# Backend reads process.env.GOOGLE_COOKIE exactly — no hardcode, no leak, uses as credential for @rohitaryal/imagefx-api
# Security: SERVER ONLY, never NEXT_PUBLIC, never browser, never logs, never returned to client, never commit .env.local, never console.log value
# Endpoints (isolated in lib/imagefx/*): Session https://labs.google/fx/api/auth/session, Generation https://aisandbox-pa.googleapis.com/v1:runImageFx via package
# Model: IMAGEN_3_5 (default), Status: READY / NOT_CONFIGURED / AUTH_FAILED / QUOTA_EXHAUSTED / RATE_LIMITED
# Architecture: NASKAH -> SCRIPT -> SCENES -> CHARACTER MASTER -> IMAGEFX via imagefx-api using GOOGLE_COOKIE -> ASSETS -> JSON2VIDEO -> VIDEO
# Example: "Nina berjalan ke sebuah hutan misterius." -> Naskah->Script->Scene Breakdown->Visual Prompt->ImageFX->PNG Validation->Scene Asset->JSON2Video/Ursina
# PRIMARY — WAJIB gunakan persis GOOGLE_COOKIE per user requirement
GOOGLE_COOKIE=
# Fallback alias — untuk backwards compatibility, tapi primary adalah GOOGLE_COOKIE
IMAGEFX_GOOGLE_COOKIE=
# Model - default IMAGEN_3_5 per FINAL ARENA spec
IMAGEFX_MODEL=IMAGEN_3_5
# Timeout ms - default 60000 (60s) per spec, bounded retry
IMAGEFX_TIMEOUT_MS=60000
# Retries - default 1 per spec, retry only network/timeout/429/5xx not auth
IMAGEFX_RETRIES=1
IMAGEFX_ENABLED=true
# Style presets: anime, cartoon, manga, fantasy, chibi, cinematic - prompt direction only
# Package usage: import { ImageFX } from '@rohitaryal/imagefx-api'; const fx = new ImageFX(process.env.GOOGLE_COOKIE); await fx.generateImage(prompt)

# --- FREE IMAGE ENGINE v2 - FreeTheAi (Fallback Secondary - Zero Budget) ---
# Repository: https://github.com/Free-The-Ai/free-ai
# API: https://api.freetheai.xyz/v1
# Model: eve/gpt-image-2 (default), eve/gpt-image-2-medium, eve/gpt-image-2-low
# Free OpenAI-compatible API, zero billing, no credit card per docs
# Requires FREETHEAI_API_KEY obtained via Discord /signup + /checkin flow at discord.gg/secrets
# No credit card required per current repository documentation
# Security: SERVER ONLY, never NEXT_PUBLIC, never browser, never logs, never returned
# Priority: 1 ImageFX primary, 2 FreeTheAi fallback if ImageFX NOT_CONFIGURED/AUTH_FAILED, 3 HF optional - NO Pollinations/ComfyUI for main pipeline per FINAL ARENA
FREETHEAI_API_KEY=
FREETHEAI_BASE_URL=https://api.freetheai.xyz/v1
FREETHEAI_ENABLED=true
# Hard rules: NO Google/Gemini/ImageFX/Whisk, NO Puter/User-Pays, NO Pollinations, NO remote ComfyUI, NO stable-diffusion.cpp per v2 spec
# Provider order: 1. FreeTheAi only — Do NOT fallback to Pollinations/ComfyUI/Google/local GPU per spec
# Keep JSON2Video, Ursina, FFmpeg

# --- HUGGING FACE ZEROGPU - FREE IMAGE WORKER (Legacy, kept until v2 PASS) ---
# Setup dari HP: https://huggingface.co/new-space -> Gradio + ZeroGPU -> upload huggingface-space/*
# Docs: docs/HUGGINGFACE_ZEROGPU_SETUP.md
HUGGINGFACE_SPACE_ID=
# Contoh: myusername/nexus-image-worker - format owner/space-name WAJIB
HUGGINGFACE_SPACE_URL=
# Optional override, contoh https://myusername-nexus-image-worker.hf.space - jika kosong auto construct dari SPACE_ID
HUGGINGFACE_API_TOKEN=
# Optional server-only secret untuk private Space - JANGAN commit, JANGAN expose ke browser
HF_IMAGE_MODEL_ID=
# --- FREE IMAGE FALLBACK - Pollinations (Zero Budget, No API Key) ---
POLLINATIONS_ENABLED=true
POLLINATIONS_BASE_URL=https://image.pollinations.ai
POLLINATIONS_MODEL=flux
# --- FREE I2V WORKER - HF ZeroGPU I2V Space ---
HUGGINGFACE_I2V_SPACE_ID=
HUGGINGFACE_I2V_SPACE_URL=
HF_I2V_MODEL_ID=
# Validated: stabilityai/stable-video-diffusion-img2vid-xt (1.5B fallback proven ZeroGPU) target Wan-AI/Wan2.1-I2V-14B-720P (14B heavy needs xlarge)

# --- FREE TTS WORKER - HF ZeroGPU TTS Space (TAHAP 5) ---
HUGGINGFACE_TTS_SPACE_ID=
HUGGINGFACE_TTS_SPACE_URL=
HF_TTS_MODEL_ID=
# Validated: facebook/mms-tts-ind (400MB Indonesian lightweight proven ZeroGPU) target coqui/XTTS-v2 (2B multilingual)

# --- IMAGE ENGINE - ComfyUI / Remote ComfyUI (Paid, jika IMAGE_ENGINE_PROVIDER=remote_comfyui) ---
# ComfyUI sebagai Image Engine - NEXUS = Orchestrator - Pertahankan backend lama
# Jika IMAGE_ENGINE_PROVIDER=huggingface pakai HF, jika remote_comfyui pakai backend ComfyUI/RunPod lama
COMFYUI_URL=http://localhost:8188
COMFYUI_MODEL=qwen-image
COMFYUI_FALLBACK_MODEL=flux-klein-4b
COMFYUI_ENABLED=true
COMFYUI_TIMEOUT_MS=120000
# Remote Worker (RunPod) - untuk production mobile-only jika tidak pakai HF free
AI_WORKER_URL=
# Contoh: https://your-runpod-comfyui-xxx.proxy.runpod.net - remote ComfyUI worker
AI_WORKER_API_KEY=
# Optional server-only secret untuk secured worker

# --- VIDEO COMPOSITOR - JSON2Video ---
JSON2VIDEO_API_KEY=
JSON2VIDEO_BASE_URL=https://api.json2video.com/v2/movies
JSON2VIDEO_ENABLED=true
JSON2VIDEO_TIMEOUT_MS=120000
JSON2VIDEO_POLLING_INTERVAL_MS=3000
JSON2VIDEO_MAX_POLLING_ATTEMPTS=40

# --- URSINA RENDERER - 2D/3D Scene Renderer ---
# Python worker - local http://localhost:8000 - 0 BUDGET LOCAL
# For Vercel production, set remote worker URL or leave NOT SET (will be NOT_CONFIGURED honest)
URSINA_URL=http://localhost:8000
URSINA_ENABLED=false
URSINA_TIMEOUT_MS=120000

# --- RESEARCH ---
RESEARCH_ENABLED=true
WIKIPEDIA_ENABLED=true
RESEARCH_MIN_SOURCES=2

# --- VERCEL ---
# Otomatis di-set oleh Vercel: VERCEL=1, VERCEL_ENV=production/preview/development
# Jangan set manual

# --- NEXT.JS ---
NODE_ENV=development

# --- REMOVE.BG - Automatic Background Removal for Character Assets ---
# Dapatkan API key di: https://www.remove.bg/api
# Digunakan di app/api/generate-hf/route.ts untuk post-processing potong background
# Jika tidak di-set, fallback ke gambar asli FLUX tanpa crash
# Jika limit habis atau error, fallback ke gambar asli
# Pricing: 50 free previews, berbayar setelahnya - https://www.remove.bg/pricing
# Env var name: Removebg_API_KEY (case sensitive per spec)
Removebg_API_KEY=
# Alias support (optional) — jika sudah ada REMOVE_BG_API_KEY atau REMOVEBG_API_KEY
REMOVE_BG_API_KEY=
REMOVEBG_API_KEY=
